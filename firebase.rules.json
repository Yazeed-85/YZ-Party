{
  "rules": {
    ".read": false,
    ".write": false,
    "rooms": {
      "$code": {
        "meta": {
          ".read": "auth != null",
          ".write": "auth != null && ((!data.exists() && newData.child('host').val() === auth.uid) || data.child('host').val() === auth.uid)",
          ".validate": "!newData.exists() || newData.hasChildren(['host', 'status', 'maxPlayers'])"
        },
        "players": {
          ".read": "auth != null && data.child(auth.uid).exists()",
          "$uid": {
            ".read": "auth != null && auth.uid === $uid",
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/meta').exists() && (data.exists() || root.child('rooms/' + $code + '/meta/status').val() === 'lobby')",
            ".validate": "newData.hasChild('name') && newData.child('name').isString() && newData.child('name').val().length <= 16"
          }
        },
        "party": {
          ".read": "auth != null && root.child('rooms/' + $code + '/players/' + auth.uid).exists()",
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid"
        },
        "game": {
          ".read": "auth != null && root.child('rooms/' + $code + '/players/' + auth.uid).exists()",
          ".write": "auth != null && root.child('rooms/' + $code + '/players/' + auth.uid).exists()"
        }
      }
    }
  }
}
